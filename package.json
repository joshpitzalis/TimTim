{
  "name": "strokes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "void prepare",
    "check": "pnpm typecheck && pnpm lint",
    "typecheck": "void prepare && tsc --noEmit",
    "ts": "void prepare && tsc --noEmit --watch",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm test:fence && pnpm test:content && pnpm test:browser",
    "test:content": "vitest run",
    "test:browser": "playwright test",
    "prepare": "effect-tsgo patch && lefthook install",
    "test:fence": "node --test src/features/writing/__tests__/fence.test.mjs"
  },
  "dependencies": {
    "effect": "4.0.5",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.56.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@void/react": "1.2.0",
    "fast-check": "4.10.2",
    "lefthook": "2.2.2",
    "oxc-transform-react": "0.152.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tailwindcss": "1.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "void": "1.2.0"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.21.0"
  }
}
