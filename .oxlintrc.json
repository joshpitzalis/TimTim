{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y"
  ],
  "jsPlugins": [
    "./scripts/oxlint-boundaries.mjs",
    "oxlint-tailwindcss"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "strokes-boundaries/no-platform-in-domain": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/no-dynamic-classes": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-deprecated-classes": "error"
  },
  "overrides": [
    {
      "files": [
        "src/**/domain/**/*.{ts,tsx}",
        "src/pages/**/*.{ts,tsx}",
        ".fence-fixtures-*/domain/*.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "navigator",
          "localStorage",
          "sessionStorage",
          "fetch",
          "PointerEvent",
          "ResizeObserver",
          "require"
        ]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    ".agents",
    ".claude",
    ".void",
    "dist",
    "test-results",
    "playwright-report"
  ],
  "settings": {
    "tailwindcss": {
      "entryPoint": "src/styles.css"
    }
  }
}
